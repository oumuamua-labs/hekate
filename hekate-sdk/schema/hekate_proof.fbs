namespace hekate.wire;

// ===== Field Elements =====

struct Block256 {
  w0: uint64;
  w1: uint64;
  w2: uint64;
  w3: uint64;
}

// ===== Sumcheck =====

table UnivariatePoly {
  coefficients: [Block256];
}

table SumcheckProof {
  round_polys: [UnivariatePoly];
  claimed_evaluation: Block256;
  skip: [Block256];
}

// ===== Merkle Opening =====

table Multiproof {
  siblings: [ubyte];
  unreached: [ubyte];
}

// ===== Fold Opening =====

table TreeOpening {
  leaves: [ubyte];
  multiproof: Multiproof;
}

// ===== Evaluation Argument =====

table PointEvaluation {
  point: [Block256];
  column_values: [Block256];
}

table FoldEvalProof {
  sumcheck_proof: SumcheckProof;
  masters: [Block256];
  mask_masters: [Block256];
  fold_rounds: [Block256];
  round_roots: [ubyte];
  final_layer: [Block256];
  openings: [TreeOpening];
}

// ===== LogUp Auxiliary =====

table LogUpAux {
  h_evals: [Block256];
  claimed_sums: [Block256];
}

// ===== Outer Argument =====

table OuterOpening {
  columns: [uint32];
  values: [Block256];
  multiproof: Multiproof;
}

table OuterProof {
  aux_root: [ubyte];
  interleaved: [Block256];
  linear: [Block256];
  quadratic: [Block256];
  pad_opening: OuterOpening;
  aux_opening: OuterOpening;
}

// ===== Top-Level Proof =====

table Proof {
  version: uint32;

  // Pool roots and main trace
  trace_root: [ubyte];
  h_root: [ubyte];
  zerocheck_proof: SumcheckProof;
  main_logup_aux: LogUpAux;
  main_point_evaluation: PointEvaluation;
  eval_proof: FoldEvalProof;

  // Chiplets (parallel arrays)
  chiplet_rows: [uint64];
  chiplet_zerocheck_proofs: [SumcheckProof];
  chiplet_logup_aux: [LogUpAux];
  chiplet_point_evaluations: [PointEvaluation];

  // Eval-claim hiding
  pad_root: [ubyte];
  outer: OuterProof;
}

root_type Proof;