namespace hekate.wire;

// ===== Field Elements =====

struct Block128 {
  lo: uint64;
  hi: uint64;
}

// ===== Sumcheck =====

table UnivariatePoly {
  coefficients: [Block128];
}

table SumcheckProof {
  round_polys: [UnivariatePoly];
  claimed_evaluation: Block128;
}

// ===== Brakedown Opening =====

table BrakedownProof {
  opened_columns: [ubyte];
  batch_path: [ubyte];
}

// ===== Evaluation Argument =====

table PointEvaluation {
  point: [Block128];
  column_values: [Block128];
}

table EvalBatchProof {
  sumcheck_proof: SumcheckProof;
  ldt_proof: BrakedownProof;
  tensor_vec: [Block128];
  masters: [Block128];
  h_ldt_proof: BrakedownProof;
}

// ===== LogUp Auxiliary =====

table LogUpEntry {
  bus_id: string;
  value: Block128;
}

table LogUpAux {
  h_evals: [LogUpEntry];
  claimed_sums: [LogUpEntry];
}

// ===== Outer Argument =====

table OuterOpening {
  columns: [uint32];
  values: [Block128];
  siblings: [ubyte];
}

table OuterProof {
  aux_root: [ubyte];
  interleaved: [Block128];
  linear: [Block128];
  quadratic: [Block128];
  pad_opening: OuterOpening;
  aux_opening: OuterOpening;
}

// ===== Top-Level Proof =====

table Proof {
  version: uint32;

  // Pool roots and main trace
  trace_root: [ubyte];
  h_root: [ubyte];
  zerocheck_proof: SumcheckProof;
  main_logup_aux: LogUpAux;
  main_point_evaluation: PointEvaluation;
  eval_proof: EvalBatchProof;

  // Chiplets (parallel arrays)
  chiplet_rows: [uint64];
  chiplet_zerocheck_proofs: [SumcheckProof];
  chiplet_logup_aux: [LogUpAux];
  chiplet_point_evaluations: [PointEvaluation];

  // Eval-claim hiding
  pad_root: [ubyte];
  outer: OuterProof;
}

root_type Proof;